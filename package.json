{
  "name": "express-api",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "19.*"
  },
  "scripts": {
    "start": "ts-node ./bin/www.ts",
    "start:dev": "ts-node-dev --respawn --transpile-only --inspect=0.0.0.0 ./bin/www.ts",
    "build": "tsc",
    "test": "jest --passWithNoTests",
    "lint": "eslint --ext .ts,.json",
    "lint:fix": "eslint . --ext .ts,.json --fix",
    "lint:dockerfile": "docker run --rm -i hadolint/hadolint < Dockerfile && :",
    "format": "prettier **/*.{js,ts,json} --check",
    "format:fix": "prettier **/*.{js,ts,json} --write",
    "lint-staged": "lint-staged",
    "postinstall": "husky install"
  },
  "dependencies": {
    "@godaddy/terminus": "^4.9.0",
    "debug": "^4.3.2",
    "dotenv": "^16.0.0",
    "express": "~4.18.0",
    "helmet": "^7.0.0",
    "morgan": "~1.10.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.0.0",
    "@commitlint/config-conventional": "^17.0.0",
    "@semantic-release/changelog": "^6.0.1",
    "@semantic-release/exec": "^6.0.2",
    "@semantic-release/git": "^10.0.1",
    "@types/debug": "^4.1.7",
    "@types/dotenv": "^8.2.0",
    "@types/express": "^4.17.13",
    "@types/morgan": "^1.9.3",
    "@typescript-eslint/eslint-plugin": "^5.4.0",
    "@typescript-eslint/parser": "^5.4.0",
    "eslint": "^8.3.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-import-resolver-typescript": "^3.0.0",
    "eslint-plugin-import": "^2.25.3",
    "eslint-plugin-jest": "^27.0.0",
    "husky": "^8.0.0",
    "jest": "^29.0.0",
    "lint-staged": "^13.0.0",
    "node": "^20.0.0",
    "prettier": "^2.4.1",
    "semantic-release": "^21.0.0",
    "semantic-release-helm": "^2.1.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.4.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0"
  }
}
